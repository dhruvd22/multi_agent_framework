# =============================================================================
# Multi-Agent Framework Environment Variables Template
# =============================================================================
# Copy this file to .env in the backend directory and fill in your values
# cp env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Required: Database connection URL
# Format: postgresql+asyncpg://user:password@host:port/database
# For Supabase: Use your Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_agent_db

# Optional: Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# For Docker Compose (if using local PostgreSQL):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multi_agent_db

# -----------------------------------------------------------------------------
# NEO4J GRAPH DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Required: Neo4j connection URI
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Optional: Neo4j connection settings
NEO4J_MAX_CONNECTION_LIFETIME=3600

# For Docker Compose (if using local Neo4j):
NEO4J_AUTH=neo4j/neo4j

# -----------------------------------------------------------------------------
# OPENAI API CONFIGURATION
# -----------------------------------------------------------------------------
# Required: Your OpenAI API key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model settings
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# -----------------------------------------------------------------------------
# BUDGET CONFIGURATION
# -----------------------------------------------------------------------------
# Budget limits in USD
BUDGET_DAILY_LIMIT=100.00
BUDGET_TASK_LIMIT=10.00
BUDGET_ENABLE_TRACKING=true
BUDGET_WARNING_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# MCP SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# MCP server settings
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
MCP_ENABLE_SANDBOX=true

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# If using Supabase for PostgreSQL instead of local Docker container
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# Frontend API URLs (for Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# For production, update these to your deployed backend URLs:
# VITE_API_URL=https://your-backend.koyeb.app
# VITE_WS_URL=wss://your-backend.koyeb.app

# =============================================================================
# QUICK START GUIDE
# =============================================================================
# 
# 1. Minimum Required Variables:
#    - OPENAI_API_KEY (MUST SET THIS)
#    - DATABASE_URL (or use Docker Compose defaults)
#    - NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD (or use Docker Compose defaults)
#
# 2. For Local Development with Docker Compose:
#    - Set OPENAI_API_KEY
#    - All database settings use defaults from docker-compose.yml
#
# 3. For Production Deployment:
#    - Set all database URLs to your production databases
#    - Set OPENAI_API_KEY
#    - Update VITE_API_URL and VITE_WS_URL to your backend URLs
#    - Set ENVIRONMENT=production
#    - Adjust budget limits as needed
#
# =============================================================================

